# MongoDB Atlas connection string. A replica set is required for transactions.
MONGODB_URI=

# Random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical URL of this deployment (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional comma-separated list of extra allowed origins for mutating requests.
TRUSTED_ORIGINS=

# Show demo credential chips on the login page.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true

# Required to allow `npm run seed` to clear and reseed the target database.
SEED_ALLOW_RESET=false
